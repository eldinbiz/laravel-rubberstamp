parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - routes
    excludePaths:
        - src/Support/browser-test-bootstrap.php
        - src/Support/browser-pest-runner.php
        - src/Support/BrowserSnapshotManager.php
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*
        -
            identifier: trait.unused
            path: src/Concerns/*
